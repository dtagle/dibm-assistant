# Variables del DIBM Assistant. Copia este archivo a .env y llena los valores.
# Nunca subas .env al repositorio: las claves de API_KEYS, el token de Cloudflare
# y la clave de LangSmith son secretos.

# Ambiente: development o production (con production se aplican las reglas de
# doc/compliance-checklist.md y el producto no arranca si alguna falla)
ENVIRONMENT=development

# Acceso: cliente:clave,cliente2:clave2 (en production, claves de 16 o más
# caracteres). Vacía, nadie puede usar /ask ni /metrics.
API_KEYS=
RATE_LIMIT_PER_MINUTE=30

# Modelo: fake (simulado, sin red) o gateway (Cloudflare Workers AI)
MODEL_PROVIDER=fake
AGENT_MAX_STEPS=3
MAX_QUESTION_CHARS=2000
PUBLICATIONS_PATH=data/publications.json

# Observabilidad
SERVICE_NAME=dibm-assistant
SLO_P95_MS=2000
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
HIDE_INPUTS=true
HIDE_OUTPUTS=true

# Cloudflare AI Gateway (obligatorias con MODEL_PROVIDER=gateway)
CF_ACCOUNT_ID=
CF_GATEWAY_ID=default
CF_API_TOKEN=

# Palancas de costo
MODEL_SMALL=@cf/meta/llama-3.1-8b-instruct-fast
MODEL_LARGE=@cf/meta/llama-3.3-70b-instruct-fp8-fast
ROUTING=true
ROUTER_MAX_CHARS=80
HISTORY_WINDOW=6
MODEL_MAX_TOKENS=300
MODEL_TEMPERATURE=0
CACHE_TTL_SECONDS=0
PRICES_PATH=data/model_prices.json
